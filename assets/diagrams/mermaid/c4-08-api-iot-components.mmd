    wh["<b>TelemetryWebhookController</b><br/><i>[Component: Spring @RestController]</i><br/>Recibe telemetría de ThingsBoard<br/>(API key por dispositivo)."]:::component
    ctl["<b>EquipmentController · IotDevicesController<br/>· AlertsController</b><br/><i>[Component: Spring @RestController]</i><br/>Equipos, calibraciones, mantenimientos,<br/>sensores y alertas."]:::component
    ing["<b>TelemetryCommandServiceImpl</b><br/><i>[Component: Spring @Service – Command Service]</i><br/>Registra lecturas y las asocia<br/>al lote en curso."]:::component
    rule["<b>AlertRuleEvaluator</b><br/><i>[Component: Domain Service]</i><br/>Compara lecturas con los rangos<br/>y genera alertas."]:::component
    cmd["<b>EquipmentCommandServiceImpl · IotDeviceCommandServiceImpl</b><br/><i>[Component: Spring @Service – Command Service]</i><br/>Equipos, calibraciones y sensores."]:::component
    job["<b>CalibrationExpirationScheduler</b><br/><i>[Component: Spring @Scheduled]</i><br/>Marca equipos no aptos al vencer<br/>la calibración."]:::component
    dom["<b>Equipment · IoTDevice · TelemetryReading · Alert</b><br/><i>[Component: Domain Model]</i><br/>Aggregates del contexto."]:::component
    ext["<b>ExternalManufacturingService · ExternalSubscriptionService</b><br/><i>[Component: Application – Outbound ACL]</i><br/>Verifica el lote en curso y el<br/>límite de dispositivos del plan."]:::component
    notif["<b>NotificationService</b><br/><i>[Component: Infrastructure – STOMP + SendGrid]</i><br/>Publica alertas en tiempo real<br/>y por correo."]:::component
    repo["<b>EquipmentRepository · IotDeviceRepository<br/>· TelemetryReadingRepository · AlertRepository</b><br/><i>[Component: Spring Data JPA Repository]</i><br/>Persistencia en MySQL."]:::component
    acl["<b>IotMonitoringContextFacade</b><br/><i>[Component: Interfaces – ACL Facade]</i><br/>Asigna sensores a lotes a pedido<br/>de Manufacturing."]:::component
