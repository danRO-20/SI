  admin -- "Administra organización, usuarios<br/>y suscripción [HTTPS]" --> doofplus
  tb -- "Envía telemetría de sensores<br/>[Webhook REST/HTTPS, JSON]" --> doofplus
  doofplus -- "Autoriza cobros de suscripción<br/>[REST/HTTPS, JSON]" --> niubiz
  doofplus -- "Envía correos<br/>[REST/HTTPS, JSON]" --> mail
  qa & prod & admin -. "Leen el código TOTP<br/>(sin integración por API)" .-> ga
