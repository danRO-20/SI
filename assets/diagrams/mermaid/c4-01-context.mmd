flowchart TB
  visitor["<b>Visitante de un laboratorio</b><br/><i>[Person]</i><br/>Evalúa DoofPlus desde la Landing Page<br/>y solicita una demostración."]:::person
  qa["<b>Especialista QA/QC</b><br/><i>[Person]</i><br/>Gestiona documentos, insumos, desviaciones,<br/>CAPA, auditorías y liberación de lotes."]:::person
  prod["<b>Jefe de Producción Farmacéutica</b><br/><i>[Person]</i><br/>Gestiona órdenes y lotes, monitorea<br/>equipos y solicita aprobaciones a Calidad."]:::person
  admin["<b>Administrador del laboratorio</b><br/><i>[Person]</i><br/>Registra la organización, usuarios,<br/>roles, sensores y la suscripción."]:::person
  doofplus["<b>DoofPlus</b><br/><i>[Software System]</i><br/>Plataforma SaaS de gestión de calidad<br/>y trazabilidad de lotes farmacéuticos<br/>(Landing Page, Web Application y RESTful API)."]:::system
  tb["<b>ThingsBoard</b><br/><i>[Software System – externo]</i><br/>Plataforma IoT que recibe los datos<br/>de los sensores de planta y los reenvía."]:::external
  niubiz["<b>Niubiz</b><br/><i>[Software System – externo]</i><br/>Pasarela de pagos para cobrar<br/>las suscripciones."]:::external
  mail["<b>SendGrid</b><br/><i>[Software System – externo]</i><br/>Servicio de correo para invitaciones,<br/>alertas y notificaciones."]:::external
  ga["<b>App autenticadora (TOTP)</b><br/><i>[Software System – externo]</i><br/>App móvil del usuario (p. ej., Google<br/>Authenticator) que genera códigos 2FA."]:::external
  visitor -- "Conoce la propuesta de valor,<br/>los planes y solicita una demo [HTTPS]" --> doofplus
  qa -- "Gestiona calidad y cumplimiento [HTTPS]" --> doofplus
