flowchart TB
  webapp["<b>Web Application</b><br/><i>[Container: Angular, Angular Material]</i>"]:::container
  subgraph API["RESTful API [Container: Spring Boot, Java 21] – Identity &amp; Access Management"]
    direction TB
    ctl["<b>AuthenticationController</b><br/><i>[Component: Spring @RestController]</i><br/>sign-up, sign-in y verificación 2FA."]:::component
    ctl2["<b>UsersController · ElectronicSignaturesController</b><br/><i>[Component: Spring @RestController]</i><br/>Alta de usuarios, roles y firmas."]:::component
    flt["<b>BearerAuthorizationRequestFilter</b><br/><i>[Component: Spring Security Filter]</i><br/>Valida el JWT en cada request."]:::component
    cmd["<b>UserCommandServiceImpl</b><br/><i>[Component: Spring @Service – Command Service]</i><br/>Da de alta usuarios, asigna roles y<br/>bloquea cuentas tras 5 intentos."]:::component
    sig["<b>SignatureCommandServiceImpl</b><br/><i>[Component: Spring @Service – Command Service]</i><br/>Verifica la identidad y registra<br/>la firma electrónica."]:::component
    qry["<b>UserQueryServiceImpl</b><br/><i>[Component: Spring @Service – Query Service]</i><br/>Consultas de usuarios y roles."]:::component
    dom["<b>User · Role · ElectronicSignature</b><br/><i>[Component: Domain Model]</i><br/>Aggregates del contexto IAM."]:::component
    tok["<b>TokenServiceImpl</b><br/><i>[Component: Infrastructure – JJWT]</i><br/>Genera y valida tokens JWT."]:::component
    hash["<b>HashingServiceImpl</b><br/><i>[Component: Infrastructure – BCrypt]</i><br/>Hash de contraseñas."]:::component
    totp["<b>TotpServiceImpl</b><br/><i>[Component: Infrastructure – RFC 6238]</i><br/>Valida los códigos 2FA."]:::component
    repo["<b>UserRepository · ElectronicSignatureRepository</b><br/><i>[Component: Spring Data JPA Repository]</i><br/>Persistencia en MySQL."]:::component
    acl["<b>IamContextFacade</b><br/><i>[Component: Interfaces – ACL Facade]</i><br/>Expone usuarios y firmas a los demás<br/>bounded contexts."]:::component
  end
