    ctl["<b>QualityDocumentsController · MaterialApprovalsController</b><br/><i>[Component: Spring @RestController]</i><br/>Documentos y versiones; dictamen<br/>de materias primas."]:::component
    ctl2["<b>BatchReviewsController · AnalyticalResultsController</b><br/><i>[Component: Spring @RestController]</i><br/>Cuarentena, resultados, OOS<br/>y liberación de lotes."]:::component
    ctl3["<b>DeviationsController · CapaActionsController</b><br/><i>[Component: Spring @RestController]</i><br/>Desviaciones, RCA y acciones CAPA."]:::component
    ctl4["<b>AuditsController · AuditTrailController · ReportsController</b><br/><i>[Component: Spring @RestController]</i><br/>Auditorías, audit trail y reportes."]:::component
    dcmd["<b>QualityDocumentCommandServiceImpl · MaterialApprovalCommandServiceImpl</b><br/><i>[Component: Spring @Service – Command Service]</i><br/>Versionado, aprobación con firma<br/>y dictamen de insumos."]:::component
    rcmd["<b>BatchReviewCommandServiceImpl</b><br/><i>[Component: Spring @Service – Command Service]</i><br/>Cuarentena, evaluación, liberación<br/>y certificado de análisis."]:::component
    vcmd["<b>DeviationCommandServiceImpl · AuditCommandServiceImpl</b><br/><i>[Component: Spring @Service – Command Service]</i><br/>Ciclo de vida de desviaciones,<br/>CAPA y auditorías."]:::component
    rep["<b>ReportGenerationServiceImpl</b><br/><i>[Component: Application Service – OpenPDF]</i><br/>Expedientes de auditoría y<br/>reportes regulatorios en PDF."]:::component
    dom["<b>QualityDocument · MaterialApproval · BatchReview<br/>· AnalyticalResult · Deviation · Audit<br/>· AuditTrailEntry · RegulatoryReport</b><br/><i>[Component: Domain Model]</i><br/>Aggregates del contexto."]:::component
    aud["<b>AuditTrailEntityListener</b><br/><i>[Component: Infrastructure – JPA Entity Listener]</i><br/>Registra quién, cuándo y qué cambió<br/>en todos los contextos (solo inserción)."]:::component
    ext["<b>ExternalIamService · ExternalManufacturingService</b><br/><i>[Component: Application – Outbound ACL]</i><br/>Firma electrónica y consulta de lotes."]:::component
    pub["<b>ApplicationEventPublisher</b><br/><i>[Component: Spring Events]</i><br/>Publica BatchReleaseDecided y<br/>MaterialApprovalDecided."]:::component
    repo["<b>Quality repositories</b><br/><i>[Component: Spring Data JPA Repository]</i><br/>Persistencia en MySQL."]:::component
    acl["<b>QualityContextFacade</b><br/><i>[Component: Interfaces – ACL Facade]</i><br/>Recibe solicitudes de aprobación<br/>y de cuarentena."]:::component
