---
title: "Database Diagram – Subscriptions & Payments Bounded Context (MySQL 8)"
---
erDiagram
  plans {
    bigint id PK
    varchar(50) name UK "Standard Lab, Enterprise"
    decimal monthly_price "(10,2)"
    decimal annual_price "(10,2)"
    char(3) currency "USD"
    int iot_device_limit
    int user_limit
  }
  subscriptions {
    bigint id PK
    bigint organization_id "ref organizations.organizations"
    bigint plan_id FK
    varchar(10) billing_cycle "MONTHLY, ANNUAL"
    varchar(20) status "PENDING, ACTIVE, CANCELLED, EXPIRED"
    date current_period_start
    date current_period_end
    tinyint(1) auto_renew
  }
  payments {
    bigint id PK
    bigint subscription_id FK
    decimal amount "(10,2)"
    char(3) currency
    varchar(100) gateway_transaction_id UK "Niubiz"
    varchar(20) status "PENDING, APPROVED, REJECTED"
    datetime processed_at
  }
  plans ||--o{ subscriptions : "subscribed by"
  subscriptions ||--o{ payments : "records"
