---
title: "Class Diagram – Quality & Compliance Bounded Context"
---
classDiagram
  direction LR
  class QualityDocument {
    <<Aggregate Root>>
    -Long id
    -String code
    -String title
    -DocumentType type
    -DocumentStatus status
    -List~DocumentVersion~ versions
    +submitForReview() void
    +approve(Long signatureId) void
    +reject(String reason) void
    +publishNewVersion(String fileUrl, String changeReason, Long authorId) DocumentVersion
  }
  class DocumentVersion {
    <<Entity>>
    -Long id
    -String versionNumber
    -String fileUrl
    -String changeReason
    -Long authorId
    -Long approvalSignatureId
  }
  class MaterialApproval {
    <<Aggregate Root>>
    -Long id
    -Long rawMaterialLotId
    -String sampleCode
    -MaterialApprovalStatus status
    -Long decidedBy
    -String reason
    +registerSample(String sampleCode) void
    +approve(Long signatureId) void
    +reject(String reason) void
  }
  class BatchReview {
    <<Aggregate Root>>
    -Long id
    -Long batchId
    -ReviewStatus status
    -LocalDateTime quarantineStartedAt
    -String sampleCode
    -List~EvidenceAttachment~ evidences
    -ReleaseCertificate certificate
    +registerSample(String sampleCode) void
    +attachEvidence(String fileUrl, String description) void
    +evaluate(List~AnalyticalResult~ results, boolean hasOpenDeviations) void
    +release(Long signatureId) ReleaseCertificate
    +reject(String reason) void
  }
  class EvidenceAttachment {
    <<Entity>>
    -Long id
    -String fileUrl
    -String description
  }
  class ReleaseCertificate {
    <<Entity>>
    -Long id
    -String certificateNumber
    -ReleaseVerdict verdict
    -Long signatureId
    -LocalDateTime issuedAt
  }
  class AnalyticalResult {
    <<Aggregate Root>>
    -Long id
    -Long batchId
    -String testName
    -BigDecimal value
    -SpecificationRange specification
    -boolean outOfSpecification
    -Long analystId
    +calculate(Map~String, BigDecimal~ variables, String formula) void
  }
  class SpecificationRange {
    <<Value Object>>
    +BigDecimal min
    +BigDecimal max
    +String unit
    +contains(BigDecimal value) boolean
  }
  class DocumentStatus {
    <<enumeration>>
    DRAFT
    IN_REVIEW
    APPROVED
    OBSOLETE
  }
  class MaterialApprovalStatus {
    <<enumeration>>
    PENDING
    SAMPLED
    APPROVED
    REJECTED
  }
  class ReviewStatus {
    <<enumeration>>
    IN_QUARANTINE
    UNDER_EVALUATION
    RELEASED
    REJECTED
  }
  class BatchReviewCommandService {
    <<interface>>
    +handle(StartQuarantineCommand command) Optional~BatchReview~
    +handle(EvaluateBatchCommand command) Optional~BatchReview~
    +handle(ReleaseBatchCommand command) Optional~ReleaseCertificate~
  }
  class ExternalIamService {
    +signRecord(Long userId, String password, String entityType, Long entityId) Optional~Long~
  }
  class ExternalManufacturingService {
    +fetchBatchStatus(Long batchId) Optional~String~
  }
  QualityDocument "1" *-- "1..*" DocumentVersion : versions
  QualityDocument --> DocumentStatus : status
  MaterialApproval --> MaterialApprovalStatus : status
  BatchReview "1" *-- "0..*" EvidenceAttachment : evidences
  BatchReview "1" *-- "0..1" ReleaseCertificate : issues
  BatchReview ..> AnalyticalResult : evaluates
  BatchReview --> ReviewStatus : status
  AnalyticalResult *-- SpecificationRange : specification
  BatchReviewCommandService ..> ExternalIamService : uses
  BatchReviewCommandService ..> ExternalManufacturingService : uses
  class Deviation {
    <<Aggregate Root>>
    -Long id
    -String code
    -Long batchId
    -Severity severity
    -DeviationStatus status
    -String description
    -RootCause rootCause
    -List~CapaAction~ actions
    +classify(Severity severity) void
    +startInvestigation() void
    +registerRootCause(RootCause rootCause) void
    +addCapaAction(CapaAction action) void
    +close() void
  }
  class CapaAction {
    <<Entity>>
    -Long id
    -CapaType type
    -String description
    -Long responsibleId
    -LocalDate dueDate
    -int progress
    -CapaStatus status
    +updateProgress(int progress) void
    +verify() void
    +isOverdue() boolean
  }
  class RootCause {
    <<Value Object>>
    +String method
    +String description
  }
  class Audit {
    <<Aggregate Root>>
    -Long id
    -AuditType type
    -LocalDate scheduledDate
    -AuditStatus status
    -List~AuditFinding~ findings
    -String evidencePackageUrl
    +start() void
    +registerFinding(FindingType type, String description) AuditFinding
    +attachEvidencePackage(String fileUrl) void
    +close() void
  }
  class AuditFinding {
    <<Entity>>
    -Long id
    -FindingType type
    -String description
  }
  class AuditTrailEntry {
    <<Aggregate Root>>
    -Long id
    -String entityType
    -String entityId
    -AuditAction action
    -String oldValue
    -String newValue
    -Long changedBy
    -LocalDateTime changedAt
    -String reason
  }
  class RegulatoryReport {
    <<Aggregate Root>>
    -Long id
    -YearMonth period
    -String fileUrl
    -LocalDateTime generatedAt
  }
  class Severity {
    <<enumeration>>
    MINOR
    MAJOR
    CRITICAL
  }
  class DeviationStatus {
    <<enumeration>>
    OPEN
    UNDER_INVESTIGATION
    CLOSED
  }
  class CapaStatus {
    <<enumeration>>
    OPEN
    IMPLEMENTED
    OVERDUE
    VERIFIED
  }
  class FindingType {
    <<enumeration>>
    FINDING
    OBSERVATION
  }
  class DeviationCommandService {
    <<interface>>
    +handle(RegisterDeviationCommand command) Optional~Deviation~
    +handle(CloseDeviationCommand command) Optional~Deviation~
  }
  class ReportGenerationService {
    <<interface>>
    +generateAuditPackage(Long organizationId, LocalDate from, LocalDate to) byte[]
    +generateMonthlyReport(Long organizationId, YearMonth period) byte[]
  }
  class NotificationService {
    <<interface>>
    +notifyCriticalDeviation(Deviation deviation) void
  }
  Deviation "1" *-- "0..*" CapaAction : resolvedBy
  Deviation *-- RootCause : rootCause
  Deviation --> Severity : severity
  Deviation --> DeviationStatus : status
  CapaAction --> CapaStatus : status
  Audit "1" *-- "0..*" AuditFinding : findings
  AuditFinding --> FindingType : type
  DeviationCommandService ..> NotificationService : uses
  ReportGenerationService ..> AuditTrailEntry : reads
  ReportGenerationService ..> Audit : packages
  ReportGenerationService ..> RegulatoryReport : creates
