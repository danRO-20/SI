title: "[Component] Web Application (Angular) – Diagrama de Componentes (C4 Nivel 3)"
---
flowchart TB
  users["<b>Usuarios de DoofPlus</b><br/><i>[Person]</i>"]:::person
  subgraph WA["Web Application [Container: Angular, Angular Material, TypeScript]"]
    direction TB
    router["<b>app.routes &amp; authGuard</b><br/><i>[Component: Angular Router, CanActivateFn]</i><br/>Rutas lazy por bounded context y<br/>protección de vistas por rol."]:::component
    layout["<b>Layout, Toolbar y Footer</b><br/><i>[Component: shared/presentation – mat-toolbar, mat-sidenav]</i><br/>Shell responsive y navegación global."]:::component
    iam["<b>iam</b><br/><i>[Component: views + IamStore + IamApi]</i><br/>Sign-in con 2FA, sesión (JWT), usuarios y firmas."]:::component
    org["<b>organizations</b><br/><i>[Component: views + store + api]</i><br/>Organización, plantas y perfiles."]:::component
    subs["<b>subscriptions</b><br/><i>[Component: views + store + api]</i><br/>Planes, pago y estado de la suscripción."]:::component
    mfg["<b>manufacturing</b><br/><i>[Component: views + ManufacturingStore + api]</i><br/>Órdenes, lotes, insumos e incidencias."]:::component
    iot["<b>iot-monitoring</b><br/><i>[Component: views + store + api]</i><br/>Equipos, sensores, lecturas y alertas."]:::component
    qual["<b>quality</b><br/><i>[Component: views (mat-table) + QualityStore + api]</i><br/>Documentos, insumos, resultados, desviaciones,<br/>CAPA, liberación, auditorías y audit trail."]:::component
    http["<b>shared/infrastructure</b><br/><i>[Component: HttpClient, BaseApi, assemblers, authInterceptor]</i><br/>Cliente REST base, conversión resource ↔ entity<br/>y token Bearer."]:::component
    i18n["<b>LanguageSwitcher</b><br/><i>[Component: ngx-translate + HttpLoader]</i><br/>public/i18n/en.json (por defecto) y es.json."]:::component
    ws["<b>Notifications Client</b><br/><i>[Component: @stomp/rx-stomp]</i><br/>Recibe alertas en tiempo real."]:::component
  end
  api["<b>RESTful API</b><br/><i>[Container: Spring Boot]</i>"]:::container
  users -- "Usa [HTTPS]" --> layout
  layout --> router
  router --> iam & org & subs & mfg & iot & qual
  iam & org & subs & mfg & iot & qual -- "Usa" --> http
  layout -- "Traduce textos" --> i18n
  http -- "JSON/HTTPS" --> api
  api -- "WebSocket (STOMP)" --> ws
  ws -- "Muestra alertas" --> layout
