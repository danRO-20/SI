---
title: "Database Diagram – Quality & Compliance (2/2): desviaciones, CAPA y auditoría Bounded Context (MySQL 8)"
---
erDiagram
  deviations {
    bigint id PK
    varchar(30) code UK
    bigint production_batch_id "ref manufacturing.production_batches"
    varchar(10) severity "MINOR, MAJOR, CRITICAL"
    varchar(20) status "OPEN, UNDER_INVESTIGATION, CLOSED"
    text description
    varchar(50) root_cause_method "nullable"
    text root_cause_description "nullable"
    datetime detected_at
    datetime closed_at "nullable"
  }
  capa_actions {
    bigint id PK
    bigint deviation_id FK
    varchar(12) type "CORRECTIVE, PREVENTIVE"
    varchar(500) description
    bigint responsible_id "ref iam.users"
    date due_date
    int progress "0-100"
    varchar(20) status "OPEN, IMPLEMENTED, OVERDUE, VERIFIED"
  }
  audits {
    bigint id PK
    varchar(20) type "INTERNAL, REGULATORY"
    date scheduled_date
    varchar(20) status "SCHEDULED, IN_PROGRESS, CLOSED"
    varchar(500) evidence_package_url "nullable"
  }
  audit_findings {
    bigint id PK
    bigint audit_id FK
    varchar(20) type "FINDING, OBSERVATION"
    varchar(500) description
  }
  audit_trail_entries {
    bigint id PK
    varchar(100) entity_type
    varchar(36) entity_id
    varchar(20) action "CREATED, UPDATED, DELETED, SIGNED"
    json old_value "nullable"
    json new_value "nullable"
    bigint changed_by "ref iam.users"
    datetime changed_at
    varchar(255) reason "nullable"
  }
  regulatory_reports {
    bigint id PK
    bigint organization_id "ref organizations.organizations"
    char(7) period "YYYY-MM"
    varchar(500) file_url
    datetime generated_at
  }
  deviations ||--o{ capa_actions : "resolved by"
  audits ||--o{ audit_findings : "records"
